{
  "runtime": {
    "type": "node",
    "version": "20"
  },
  "init": {
    "darwin": "{{WORKBUDDY_INIT_COMMAND}}",
    "linux": "{{WORKBUDDY_INIT_COMMAND}}",
    "win32": "{{WORKBUDDY_INIT_COMMAND}}"
  },
  "auth": {
    "darwin": "{{WORKBUDDY_AUTH_COMMAND}}",
    "linux": "{{WORKBUDDY_AUTH_COMMAND}}",
    "win32": "{{WORKBUDDY_AUTH_COMMAND}}"
  },
  "status": {
    "darwin": "{{WORKBUDDY_STATUS_COMMAND}}",
    "linux": "{{WORKBUDDY_STATUS_COMMAND}}",
    "win32": "{{WORKBUDDY_STATUS_COMMAND}}"
  },
  "unAuth": {
    "darwin": "{{WORKBUDDY_UNAUTH_COMMAND}}",
    "linux": "{{WORKBUDDY_UNAUTH_COMMAND}}",
    "win32": "{{WORKBUDDY_UNAUTH_COMMAND}}"
  },
  "statusMatch": "\"authenticated\"\\s*:\\s*true",
  "authUrlDomain": "{{AUTH_URL_DOMAIN}}",
  "authWaitForExit": true,
  "versionCheck": {
    "command": {
      "darwin": "{{WORKBUDDY_CHECK_COMMAND}}",
      "win32": "{{WORKBUDDY_CHECK_COMMAND}}",
      "linux": "{{WORKBUDDY_CHECK_COMMAND}}"
    },
    "minVersion": "1.0.0",
    "versionPattern": "workbuddy-ready=(\\d+\\.\\d+\\.\\d+)"
  }
}
