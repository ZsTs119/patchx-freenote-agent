{
  "common": {
    "branding": {
      "displayName": "PatchXFreeNote",
      "pluginName": "patchxfreenote"
    },
    "skillSource": "skills/patchxnote-mcp",
    "skillDestination": "skills/patchxnote-mcp"
  },
  "environments": {
    "production": {
      "apiBaseURL": "https://freenote.patch-x.cn",
      "mcpURL": "https://freenote.patch-x.cn/mcp"
    },
    "test": {
      "apiBaseURL": "https://ws-lab.patch-x.cn/patchnote-test-api",
